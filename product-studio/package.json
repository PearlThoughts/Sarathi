{
  "name": "@pearlthoughts/sarathi-product-studio",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build:verify",
    "build:verify": "PAYLOAD_SECRET=product-studio-build-verification-secret PRODUCT_STUDIO_DATABASE_URL=postgresql://build:build@127.0.0.1:5432/product_studio SARATHI_API_BASE_URL=http://127.0.0.1:3001 SARATHI_PRODUCT_STUDIO_READ_TOKEN=build-verification-token SARATHI_PRODUCT_STUDIO_WORKSPACE_ID=00000000-0000-4000-8000-000000000001 next build",
    "dev": "next dev",
    "lint": "biome check src/app src/collections src/domain src/server src/views src/payload.config.ts tests tests-browser package.json tsconfig.json next.config.ts postcss.config.mjs vitest.config.ts playwright.config.ts && oxlint src/app src/collections src/domain src/server src/views src/payload.config.ts tests tests-browser playwright.config.ts",
    "payload": "payload",
    "start": "next start",
    "test": "vitest run",
    "test:browser": "playwright test --config playwright.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@payloadcms/db-postgres": "3.87.1",
    "@payloadcms/next": "3.87.1",
    "@xyflow/react": "12.11.2",
    "graphql": "^16.8.1",
    "next": "16.2.6",
    "payload": "3.87.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "vitest": "3.2.6"
  }
}
